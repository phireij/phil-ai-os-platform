FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PHIL_AI_OS_STATE_DIR=/var/lib/phil-ai-os/ao-mvp \
    PHIL_AI_OS_INTERVAL_SECONDS=300

WORKDIR /app
COPY scripts/ /app/scripts/
COPY ops/authorizations/ /app/ops/authorizations/
COPY ops/autonomous-work-queue/ /app/ops/autonomous-work-queue/
COPY ops/runtime/ /app/ops/runtime/
COPY policy/ /app/policy/

RUN addgroup --system --gid 10001 philaios \
    && adduser --system --uid 10001 --ingroup philaios --home /nonexistent philaios \
    && mkdir -p /var/lib/phil-ai-os/ao-mvp \
    && chown 10001:10001 /var/lib/phil-ai-os/ao-mvp

USER 10001:10001
VOLUME ["/var/lib/phil-ai-os/ao-mvp"]
ENTRYPOINT ["python", "/app/scripts/ao_mvp_service_loop.py"]
