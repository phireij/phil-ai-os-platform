FROM python:3.12-alpine

WORKDIR /srv
RUN pip install --no-cache-dir --disable-pip-version-check cryptography==47.0.0 google-auth==2.50.0 psycopg[binary]==3.2.9 requests==2.32.4 \
    && addgroup -S -g 10002 app \
    && adduser -S -D -u 10002 -G app app
COPY ops/mission-control-identity/google_oidc_config.py /srv/google_oidc_config.py
COPY ops/mission-control-identity/google_subject_enrollment.py /srv/google_subject_enrollment.py
COPY ops/mission-control-identity/reauthentication_attestation.py /srv/reauthentication_attestation.py
COPY ops/mission-control-identity/r3_attestation_handoff_config.py /srv/r3_attestation_handoff_config.py
COPY ops/mission-control-identity/r3_attestation_handoff.py /srv/r3_attestation_handoff.py
COPY ops/mission-control-identity/r3_attestation_metadata_writer_config.py /srv/r3_attestation_metadata_writer_config.py
COPY ops/mission-control-identity/r3_attestation_metadata_writer.py /srv/r3_attestation_metadata_writer.py
COPY ops/mission-control-identity/google_identity_probe.py /srv/google_identity_probe.py
USER app
EXPOSE 8092
ENTRYPOINT ["python3", "/srv/google_identity_probe.py"]
