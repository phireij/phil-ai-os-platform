{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phil-ai-os.local/contracts/mission-control/notification-read-model.v1.schema.json",
  "title": "Mission Control local notification outbox read model",
  "type": "object",
  "additionalProperties": false,
  "required": ["notifications", "next_cursor", "transport_status", "authority_effect"],
  "properties": {
    "notifications": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["notification_id", "kind", "priority", "decision_id", "proposal_id", "delivery_state", "attempt_count", "created_at", "last_attempt_at", "authority_effect"],
        "properties": {
          "notification_id": {"type": "string", "minLength": 16, "maxLength": 200},
          "kind": {"const": "ceo_decision_recorded"},
          "priority": {"const": "medium"},
          "decision_id": {"type": "string", "minLength": 16, "maxLength": 200},
          "proposal_id": {"type": "string", "minLength": 16, "maxLength": 200},
          "delivery_state": {"const": "not_configured"},
          "attempt_count": {"const": 0},
          "created_at": {"type": "string", "format": "date-time"},
          "last_attempt_at": {"type": "null"},
          "authority_effect": {"const": "none"}
        }
      }
    },
    "next_cursor": {"type": ["string", "null"], "pattern": "^[0-9]+$"},
    "transport_status": {"const": "not_configured"},
    "authority_effect": {"const": "none"}
  }
}
