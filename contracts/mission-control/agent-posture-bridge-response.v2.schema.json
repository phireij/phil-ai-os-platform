{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phil-ai-os://mission-control/agent-posture-bridge-response.v2",
  "title": "Mission Control bounded agent-posture bridge response v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "status", "source_generated_at", "multi_agent", "agents_available", "agents_truncated", "agent_runtime", "worker_readiness", "handoffs", "handoffs_available", "handoffs_truncated", "governance", "authority_effect"],
  "properties": {
    "contract_version": {"const": 2},
    "status": {"type": "string", "minLength": 1, "maxLength": 200},
    "source_generated_at": {"type": ["string", "null"], "format": "date-time", "description": "Validated timestamp copied from upstream read-model generated_at; null when absent or invalid."},
    "multi_agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agents"],
      "properties": {
        "agents": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "allOf": [
              {
                "if": {"properties": {"readiness": {"properties": {"state": {"const": "ready"}}, "required": ["state"]}}, "required": ["readiness"]},
                "then": {
                  "properties": {
                    "evidence_complete": {"const": true},
                    "registry": {"properties": {"enabled": {"const": true}, "assignable": {"const": true}, "evidence_complete": {"const": true}}},
                    "presence": {"properties": {"state": {"const": "fresh"}, "observed_at": {"type": "string", "format": "date-time"}, "age_seconds": {"type": "integer", "minimum": 0, "maximum": 120}, "identity_verified": {"const": true}, "evidence_complete": {"const": true}}},
                    "workload": {"properties": {"evidence_complete": {"const": true}, "active_task_count": {"const": 0}}},
                    "readiness": {"properties": {"grants_authority": {"const": false}}}
                  }
                }
              }
            ],
            "required": ["agent_id", "authority_ceiling", "evidence_complete", "registry", "presence", "workload", "readiness"],
            "properties": {
              "agent_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 80},
              "authority_ceiling": {"type": ["string", "null"], "maxLength": 40},
              "evidence_complete": {"type": ["boolean", "null"]},
              "registry": {
                "type": "object", "additionalProperties": false,
                "required": ["enabled", "assignable", "evidence_complete"],
                "properties": {
                  "enabled": {"type": ["boolean", "null"]},
                  "assignable": {"type": ["boolean", "null"]},
                  "evidence_complete": {"type": ["boolean", "null"]}
                }
              },
              "presence": {
                "type": "object", "additionalProperties": false,
                "required": ["state", "identity_verified", "evidence_complete", "observed_at", "age_seconds"],
                "properties": {
                "state": {"enum": ["fresh", "stale", "offline", "unknown", null]},
                  "identity_verified": {"type": ["boolean", "null"]},
                  "evidence_complete": {"type": ["boolean", "null"]},
                  "observed_at": {"type": ["string", "null"], "format": "date-time"},
                  "age_seconds": {"type": ["integer", "null"], "minimum": 0, "maximum": 2147483647}
                }
              },
              "workload": {
                "type": "object", "additionalProperties": false,
                "required": ["evidence_complete", "active_task_count"],
                "properties": {
                  "evidence_complete": {"type": ["boolean", "null"]},
                  "active_task_count": {"type": ["integer", "null"], "minimum": 0, "maximum": 2147483647}
                }
              },
              "readiness": {
                "type": "object",
                "additionalProperties": false,
                "required": ["state", "reason", "grants_authority"],
                "properties": {
                  "state": {"enum": ["unassignable", "busy", "ready", "stale", "offline", "indeterminate", null]},
                  "reason": {"type": ["string", "null"], "maxLength": 120},
                "grants_authority": {"const": false}
                }
              }
            }
          }
        }
      }
    },
    "agents_available": {"type": "boolean"},
    "agents_truncated": {"type": "boolean"},
    "agent_runtime": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["presence", "workload", "runtime", "governance"],
      "properties": {
        "presence": {
          "type": "object", "additionalProperties": false,
          "required": ["logical_presence", "heartbeat_age_seconds", "observation_type"],
          "properties": {
            "logical_presence": {"type": "string", "maxLength": 200},
            "heartbeat_age_seconds": {"type": ["integer", "null"], "minimum": 0, "maximum": 2147483647},
            "observation_type": {"type": "string", "maxLength": 200}
          }
        },
        "workload": {
          "type": "object", "additionalProperties": false,
          "required": ["active_task_count", "source"],
          "properties": {
            "active_task_count": {"type": ["integer", "null"], "minimum": 0, "maximum": 2147483647},
            "source": {"type": "string", "maxLength": 200}
          }
        },
        "runtime": {
          "type": "object", "additionalProperties": false,
          "required": ["running", "restart_count"],
          "properties": {
            "running": {"type": ["boolean", "null"]},
            "restart_count": {"type": ["integer", "null"], "minimum": 0, "maximum": 2147483647}
          }
        },
        "governance": {
          "type": "object", "additionalProperties": false,
          "required": ["presence_authority_effect"],
          "properties": {"presence_authority_effect": {"type": "string", "maxLength": 200}}
        }
      }
    },
    "worker_readiness": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["agent_id", "task_class_scope", "readiness", "reason_code", "authority_effect", "automatic_assignment", "automatic_retry", "automatic_reroute", "automatic_execution"],
      "properties": {
        "agent_id": {"type": "string", "maxLength": 200},
        "task_class_scope": {"type": "string", "maxLength": 200},
        "readiness": {"type": "string", "maxLength": 200},
        "reason_code": {"type": "string", "maxLength": 200},
        "authority_effect": {"type": "string", "maxLength": 200},
        "automatic_assignment": {"const": false},
        "automatic_retry": {"const": false},
        "automatic_reroute": {"const": false},
        "automatic_execution": {"const": false}
      }
    },
    "handoffs": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record_present"],
        "properties": {"record_present": {"const": true}}
      },
      "description": "Presence-only placeholders; handoff identifiers, text, and payload fields are not forwarded."
    },
    "handoffs_available": {"type": "boolean"},
    "handoffs_truncated": {"type": "boolean"},
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["presence_authority_effect", "worker_readiness_authority_effect"],
      "properties": {
        "presence_authority_effect": {"type": "string", "maxLength": 200},
        "worker_readiness_authority_effect": {"type": "string", "maxLength": 200}
      }
    },
    "authority_effect": {"const": "none"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "multi_agent": {
            "properties": {
              "agents": {
                "contains": {
                  "properties": {"readiness": {"properties": {"state": {"const": "ready"}}, "required": ["state"]}},
                  "required": ["readiness"]
                }
              }
            },
            "required": ["agents"]
          }
        },
        "required": ["multi_agent"]
      },
      "then": {"properties": {"source_generated_at": {"type": "string", "format": "date-time"}}}
    }
  ]
}
