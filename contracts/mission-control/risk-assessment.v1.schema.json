{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phil-ai-os.local/contracts/mission-control/risk-assessment.v1.schema.json",
  "title": "Mission Control risk assessment v1 (inactive)",
  "type": "object",
  "additionalProperties": false,
  "required": ["assessment_id", "mission_id", "risk_level", "factors", "required_gate", "assessed_at", "policy_version", "activation_state", "automatic_execution", "authority_effect"],
  "properties": {
    "assessment_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "mission_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "risk_level": {"enum": ["R0", "R1", "R2", "R3", "R4"]},
    "factors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"enum": ["environment", "reversibility", "financial_or_customer_impact", "data_sensitivity", "breadth", "privilege", "external_visibility", "uncertainty"]}
    },
    "required_gate": {"enum": ["audit_only", "ceo_approval", "ceo_reauthenticate", "ceo_typed_confirmation", "blocked"]},
    "assessed_at": {"type": "string", "format": "date-time"},
    "policy_version": {"type": "string", "minLength": 1, "maxLength": 100},
    "activation_state": {"const": "design_only_inactive"},
    "automatic_execution": {"const": false},
    "authority_effect": {"const": "none"}
  },
  "allOf": [
    {"if": {"properties": {"risk_level": {"const": "R4"}}, "required": ["risk_level"]}, "then": {"properties": {"required_gate": {"const": "blocked"}}}},
    {"if": {"properties": {"risk_level": {"const": "R3"}}, "required": ["risk_level"]}, "then": {"properties": {"required_gate": {"const": "ceo_typed_confirmation"}}}}
  ]
}
