{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phil-ai-os.local/contracts/mission-control/proposal-evidence-manifest.v1.schema.json",
  "title": "Signed immutable Mission Control proposal-evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "references", "signature"],
  "properties": {
    "schema": {"const": "phil-ai-os-mission-control-evidence-manifest"},
    "version": {"const": 1},
    "references": {"type": "array", "maxItems": 1000, "items": {"type": "object", "additionalProperties": false, "required": ["project_id", "ref", "source_kind", "observed_at"], "properties": {"project_id": {"enum": ["phil-ai-os", "rubys-cake-delights-hq", "kcfc-portal"]}, "ref": {"type": "string", "pattern": "^evidence:sha256:[0-9a-f]{64}$"}, "source_kind": {"type": "string", "minLength": 1, "maxLength": 100}, "observed_at": {"type": "string", "format": "date-time"}}}},
    "signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
