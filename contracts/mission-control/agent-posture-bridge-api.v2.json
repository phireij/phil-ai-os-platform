{
  "schema": "phil-ai-os-mission-control-agent-posture-api",
  "version": 2,
  "status": "workspace_contract_not_deployed",
  "activation_authorized": false,
  "authority_effect": "none",
  "mutation_authorized": false,
  "route": {
    "method": "GET",
    "path": "/api/agent-posture",
    "authentication": "bearer CEO token",
    "required_scope": "mission_control:read",
    "success_response_schema": "contracts/mission-control/agent-posture-bridge-response.v2.schema.json"
  },
  "source_boundary": {
