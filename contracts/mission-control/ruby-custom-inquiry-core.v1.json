  "trusted_context_fields": [
    "issuer",
    "subject",
    "project_id",
    "source_system",
    "source_instance"
  ],
  "required_injected_policy": [
    "project_id",
    "source_system",
    "source_instance",
    "policy_version",
    "synthetic_only=true",
    "allowed_contact_channels=email for synthetic fixture only"
  ],
  "extra_semantic_checks": [
    "strict UTF-8; reject duplicate JSON members and nonfinite values",
    "reject control characters; notes permit newline/tab; preserve exact text",
    "actual calendar validity, no availability implication",
    "exact current trusted catalog on new writes; historical recovery never reprices",
    "unique SKUs, exact quantity-times-unit-price line totals and exact subtotal",
    "closed contact has no verification or authority claims",
    "body channel policy and all caller owner/project/source bindings must remain authorized",
    "all received results require immutable full revision, derived summary, audit and original receipt",
    "ambiguous persistence fences all store writes until authoritative reconciliation",
    "missing history means unknown, never proof of noncommit or retry authorization"
  ],
  "excluded": [
    "HTTP routes",
    "customer transport",
    "images and image metadata",
    "provider integration",
    "real contacts",
    "production policy/retention/deployment"
  ]
}
