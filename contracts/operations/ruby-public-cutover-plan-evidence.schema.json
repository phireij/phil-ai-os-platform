{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phil-ai-os.local/contracts/operations/ruby-public-cutover-plan-evidence.schema.json",
  "title": "Ruby public cutover plan confirmation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "runbook_ref",
    "checks",
    "evidence_refs",
    "contains_secret_material",
    "authority",
    "evidence_complete",
    "confirmation_green",
    "decision"
  ],
  "properties": {
    "version": {"const": "ruby-public-cutover-plan-evidence-v1"},
    "runbook_ref": {"const": "docs/SPRINT_7_WOOCOMMERCE_STAGING_CUTOVER_RUNBOOK_2026-08-28.md"},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicable_launch_gates_green",
        "final_catalog_version_confirmed",
        "near_cutover_recovery_green",
        "main_branch_protection_green",
        "rollback_abort_path_confirmed",
        "ssl_domain_readiness_confirmed",
        "cutover_window_and_operator_confirmed",
        "pre_cutover_smoke_plan_confirmed",
        "post_cutover_smoke_plan_confirmed",
        "ceo_final_go_no_go_accepted",
        "cto_signoff_recorded"
      ],
      "properties": {
        "applicable_launch_gates_green": {"type": "boolean"},
        "final_catalog_version_confirmed": {"type": "boolean"},
        "near_cutover_recovery_green": {"type": "boolean"},
        "main_branch_protection_green": {"type": "boolean"},
        "rollback_abort_path_confirmed": {"type": "boolean"},
        "ssl_domain_readiness_confirmed": {"type": "boolean"},
        "cutover_window_and_operator_confirmed": {"type": "boolean"},
        "pre_cutover_smoke_plan_confirmed": {"type": "boolean"},
        "post_cutover_smoke_plan_confirmed": {"type": "boolean"},
        "ceo_final_go_no_go_accepted": {"type": "boolean"},
        "cto_signoff_recorded": {"type": "boolean"}
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "contains_secret_material": {"const": false},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dns_cutover_authorized",
        "site_cutover_authorized",
        "production_publish_authorized",
        "payment_execution_authorized",
        "order_creation_authorized",
        "automatic_production_execution_authorized",
        "automatic_rollback_authorized"
      ],
      "properties": {
        "dns_cutover_authorized": {"const": false},
        "site_cutover_authorized": {"const": false},
        "production_publish_authorized": {"const": false},
        "payment_execution_authorized": {"const": false},
        "order_creation_authorized": {"const": false},
        "automatic_production_execution_authorized": {"const": false},
        "automatic_rollback_authorized": {"const": false}
      }
    },
    "evidence_complete": {"type": "boolean"},
    "confirmation_green": {"type": "boolean"},
    "decision": {
      "enum": [
        "PENDING_PUBLIC_CUTOVER_PLAN_CONFIRMATION_FAIL_CLOSED",
        "PUBLIC_CUTOVER_PLAN_CONFIRMED_GREEN"
      ]
    }
  }
}
