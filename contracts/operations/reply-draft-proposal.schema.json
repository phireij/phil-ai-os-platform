{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phil-ai-os.local/contracts/operations/reply-draft-proposal.schema.json",
  "title": "Phil AI OS Operations Reply Draft Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "state",
    "reply_draft_id",
    "task_candidate_id",
    "lifecycle_correlation_id",
    "source",
    "external_event_id",
    "task_type",
    "normalized_intent",
    "locale",
    "draft_text",
    "drafted_by",
    "governance_approval_required",
    "governance_approval_state",
    "operator_decision",
    "authority"
  ],
  "properties": {
    "schema": {"const": "phil-ai-os-operations-reply-draft-proposal"},
    "version": {"const": 1},
    "state": {"const": "awaiting_operator_approval"},
    "reply_draft_id": {"type": "string", "pattern": "^ops-reply:[a-f0-9]{24}$"},
    "task_candidate_id": {"type": "string", "pattern": "^ops-task:[a-f0-9]{24}$"},
    "lifecycle_correlation_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "source": {"enum": ["facebook", "instagram", "telegram", "whatsapp", "google_business"]},
    "external_event_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "task_type": {"type": "string", "minLength": 1, "maxLength": 80},
    "normalized_intent": {"type": "string", "minLength": 1, "maxLength": 80},
    "locale": {"enum": ["en", "ja", "unknown"]},
    "draft_text": {"type": "string", "minLength": 1, "maxLength": 4000},
    "drafted_by": {"enum": ["hermes", "operator"]},
    "governance_approval_required": {"type": "boolean"},
    "governance_approval_state": {"enum": ["required", "not_required"]},
    "operator_decision": {"type": "null"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "draft_only",
        "operator_approval_required",
        "automatic_execution",
        "execution_authorized",
        "channel_reply_authorized",
        "network_dispatch_authorized",
        "woo_commerce_mutation_authorized",
        "order_creation_authorized",
        "payment_execution_authorized",
        "sms_send_authorized",
        "inventory_mutation_authorized",
        "production_publish_authorized",
        "mutation_authorized",
        "authority_effect"
      ],
      "properties": {
        "draft_only": {"const": true},
        "operator_approval_required": {"const": true},
        "automatic_execution": {"const": false},
        "execution_authorized": {"const": false},
        "channel_reply_authorized": {"const": false},
        "network_dispatch_authorized": {"const": false},
        "woo_commerce_mutation_authorized": {"const": false},
        "order_creation_authorized": {"const": false},
        "payment_execution_authorized": {"const": false},
        "sms_send_authorized": {"const": false},
        "inventory_mutation_authorized": {"const": false},
        "production_publish_authorized": {"const": false},
        "mutation_authorized": {"const": false},
        "authority_effect": {"const": "none"}
      }
    }
  }
}
