{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phil-ai-os.local/contracts/operations/reply-operator-decision-packet.schema.json",
  "title": "Phil AI OS Operations Reply Operator Decision Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "state",
    "operator_decision_packet_id",
    "reply_draft_id",
    "decision_proposal_id",
    "task_candidate_id",
    "lifecycle_correlation_id",
    "source",
    "locale",
    "draft_text",
    "recommendation",
    "operator_decision",
    "authority"
  ],
  "properties": {
    "schema": {"const": "phil-ai-os-operations-reply-operator-decision-packet"},
    "version": {"const": 1},
    "state": {"const": "awaiting_explicit_operator_decision"},
    "operator_decision_packet_id": {"type": "string", "pattern": "^ops-reply-operator:[a-f0-9]{24}$"},
    "reply_draft_id": {"type": "string", "pattern": "^ops-reply:[a-f0-9]{24}$"},
    "decision_proposal_id": {"type": "string", "pattern": "^ops-reply-decision:[a-f0-9]{24}$"},
    "task_candidate_id": {"type": "string", "pattern": "^ops-task:[a-f0-9]{24}$"},
    "lifecycle_correlation_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "source": {"enum": ["facebook", "instagram", "telegram", "whatsapp", "google_business"]},
    "locale": {"enum": ["en", "ja", "unknown"]},
    "draft_text": {"type": "string", "minLength": 1, "maxLength": 4000},
    "recommendation": {"enum": ["recommend_future_dispatch", "request_reply_revision", "reject_reply_draft"]},
    "operator_decision": {"type": "null"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator_review_only",
        "operator_decision_required",
        "reply_approved",
        "channel_reply_authorized",
        "network_dispatch_authorized",
        "execution_authorized",
        "woo_commerce_mutation_authorized",
        "order_creation_authorized",
        "payment_execution_authorized",
        "sms_send_authorized",
        "inventory_mutation_authorized",
        "production_publish_authorized",
        "mutation_authorized",
        "authority_effect"
      ],
      "properties": {
        "operator_review_only": {"const": true},
        "operator_decision_required": {"const": true},
        "reply_approved": {"const": false},
        "channel_reply_authorized": {"const": false},
        "network_dispatch_authorized": {"const": false},
        "execution_authorized": {"const": false},
        "woo_commerce_mutation_authorized": {"const": false},
        "order_creation_authorized": {"const": false},
        "payment_execution_authorized": {"const": false},
        "sms_send_authorized": {"const": false},
        "inventory_mutation_authorized": {"const": false},
        "production_publish_authorized": {"const": false},
        "mutation_authorized": {"const": false},
        "authority_effect": {"const": "none"}
      }
    }
  }
}
