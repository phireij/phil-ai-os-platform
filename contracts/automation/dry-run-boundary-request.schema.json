{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phil-ai-os.local/contracts/automation/dry-run-boundary-request.schema.json",
  "title": "Phil AI OS Dry-Run Boundary Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "plan_id", "lifecycle_correlation_id", "target", "operation", "mode", "task_class", "assigned_agent", "dry_run", "dispatch", "network_call", "automatic_execution", "execution_authorized", "channel_reply_authorized", "mutation_authorized", "authority_effect"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "plan_id": {"type": "string", "minLength": 1},
    "lifecycle_correlation_id": {"type": "string", "minLength": 1},
    "target": {"const": "execution_boundary"},
    "operation": {"const": "preview_request"},
    "mode": {"const": "dry_run"},
    "task_class": {"const": "general"},
    "assigned_agent": {"const": "hermes"},
    "dry_run": {"const": true},
    "dispatch": {"const": false},
    "network_call": {"const": false},
    "automatic_execution": {"const": false},
    "execution_authorized": {"const": false},
    "channel_reply_authorized": {"const": false},
    "mutation_authorized": {"const": false},
    "authority_effect": {"const": "none"}
  }
}
