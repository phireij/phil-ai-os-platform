{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phil-ai-os.local/contracts/cx/checkout-intent.schema.json",
  "title": "Phil AI OS CX Checkout Intent",
  "type": "object",
  "additionalProperties": false,
  "required": ["intent_id", "locale", "items", "fulfillment", "mutation_authorized"],
  "properties": {
    "intent_id": {"type": "string", "minLength": 1},
    "locale": {"enum": ["en", "ja"]},
    "items": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["sku", "quantity"], "properties": {"sku": {"type": "string"}, "quantity": {"type": "integer", "minimum": 1}}}},
    "fulfillment": {"enum": ["pickup"]},
    "requested_pickup_at": {"type": ["string", "null"], "format": "date-time"},
    "mutation_authorized": {"const": false}
  }
}
