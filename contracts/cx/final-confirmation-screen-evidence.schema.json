{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phil-ai-os.local/contracts/cx/final-confirmation-screen-evidence.schema.json",
  "title": "Phil AI OS Actual WooCommerce Final Confirmation Screen Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "evidence_id",
    "environment",
    "capture_method",
    "captured_at",
    "synthetic_customer_data_only",
    "contains_personal_data",
    "contains_secret_material",
    "screen_capture_refs",
    "observations",
    "authority",
    "evidence_complete",
    "actual_final_confirmation_screen_reviewed"
  ],
  "properties": {
    "version": {"const": "ruby-woocommerce-final-confirmation-screen-evidence-v1"},
    "evidence_id": {"type": "string", "minLength": 1},
    "environment": {"const": "preproduction"},
    "capture_method": {"enum": ["manual_browser_sanitized", "browser_screenshot_and_dom_notes"]},
    "captured_at": {"type": ["string", "null"], "format": "date-time"},
    "source_url_class": {"const": "sanitized_preproduction_checkout"},
    "synthetic_customer_data_only": {"type": "boolean"},
    "contains_personal_data": {"const": false},
    "contains_secret_material": {"const": false},
    "screen_capture_refs": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_ref", "sha256", "redaction_applied", "contains_personal_data", "contains_secret_material"],
        "properties": {
          "artifact_ref": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "redaction_applied": {"type": "boolean"},
          "contains_personal_data": {"const": false},
          "contains_secret_material": {"const": false}
        }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_name_quantity_options_visible",
        "subtotal_shipping_total_visible",
        "payment_method_visible",
        "payment_timing_or_deadline_visible",
        "fulfillment_timing_visible",
        "cancellation_returns_terms_visible_or_linked",
        "correction_path_available_before_submission",
        "final_action_label_unambiguous",
        "final_action_not_invoked",
        "tokushoho_disclosure_visible_or_linked",
        "tax_display_matches_exempt_posture",
        "konbini_three_day_deadline_reconciled_when_selected"
      ],
      "properties": {
        "product_name_quantity_options_visible": {"type": "boolean"},
        "subtotal_shipping_total_visible": {"type": "boolean"},
        "payment_method_visible": {"type": "boolean"},
        "payment_timing_or_deadline_visible": {"type": "boolean"},
        "fulfillment_timing_visible": {"type": "boolean"},
        "cancellation_returns_terms_visible_or_linked": {"type": "boolean"},
        "correction_path_available_before_submission": {"type": "boolean"},
        "final_action_label_unambiguous": {"type": "boolean"},
        "final_action_not_invoked": {"const": true},
        "tokushoho_disclosure_visible_or_linked": {"type": "boolean"},
        "tax_display_matches_exempt_posture": {"type": "boolean"},
        "konbini_three_day_deadline_reconciled_when_selected": {"type": "boolean"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order_creation_authorized",
        "payment_execution_authorized",
        "production_publish_authorized",
        "catalog_mutation_authorized",
        "dns_cutover_authorized"
      ],
      "properties": {
        "order_creation_authorized": {"const": false},
        "payment_execution_authorized": {"const": false},
        "production_publish_authorized": {"const": false},
        "catalog_mutation_authorized": {"const": false},
        "dns_cutover_authorized": {"const": false}
      }
    },
    "review_notes": {"type": "array", "items": {"type": "string"}},
    "evidence_complete": {"type": "boolean"},
    "actual_final_confirmation_screen_reviewed": {"type": "boolean"}
  }
}
