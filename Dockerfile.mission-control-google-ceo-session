FROM python:3.12-alpine

WORKDIR /srv
RUN pip install --no-cache-dir --disable-pip-version-check google-auth==2.62.0 requests==2.34.2 \
    && addgroup -S -g 10003 app \
    && adduser -S -D -u 10003 -G app app
COPY ops/mission-control-identity/google_oidc_config.py /srv/google_oidc_config.py
COPY ops/mission-control-identity/google_identity_probe.py /srv/google_identity_probe.py
COPY ops/mission-control-identity/conversation_store.py /srv/conversation_store.py
COPY ops/mission-control-identity/provider_runtime.py /srv/provider_runtime.py
COPY ops/mission-control-identity/notification_delivery.py /srv/notification_delivery.py
COPY ops/mission-control-identity/proposal_evidence.py /srv/proposal_evidence.py
COPY ops/mission-control-identity/conversation_recovery.py /srv/conversation_recovery.py
COPY ops/mission-control-identity/google_ceo_session.py /srv/google_ceo_session.py
USER app
EXPOSE 8093
ENTRYPOINT ["python3", "/srv/google_ceo_session.py"]
