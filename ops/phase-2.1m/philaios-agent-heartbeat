#!/usr/bin/env bash
set -euo pipefail

STATE_DIR="${PHIL_AI_OS_AGENT_PRESENCE_DIR:-/var/lib/phil-ai-os/agent-presence}"
STATE_FILE="$STATE_DIR/hermes.json"
mkdir -p "$STATE_DIR"
chmod 0755 "$STATE_DIR"

HERMES="$(docker ps --format '{{.Names}}' | grep '^hermes-agent-whow' | head -n1)"
test -n "$HERMES"

# The heartbeat is not inferred from container liveness. It is emitted only
# after the already-installed Hermes Mission Control client completes an
# authenticated read of the Control API snapshot using Hermes' existing token.
OBSERVED_JSON="$(docker exec -i "$HERMES" python3 - <<'PY'
import ast,json,pathlib,subprocess
path='/usr/local/bin/philaios-mission-control'
src=pathlib.Path(path).read_text(encoding='utf-8')
tree=ast.parse(src)
read_commands=None
for node in tree.body:
    if isinstance(node,ast.Assign):
        for target in node.targets:
            if isinstance(target,ast.Name) and target.id=='READ_COMMANDS':
                read_commands=ast.literal_eval(node.value)
                break
    if read_commands is not None:
        break
assert isinstance(read_commands,dict) and read_commands
command=next((k for k,v in read_commands.items() if str(v).rstrip('/')=='/v1/mission-control/snapshot'),None)
assert command, 'snapshot read command unavailable'
p=subprocess.run([path,command],capture_output=True,text=True,timeout=15)
assert p.returncode==0, p.stderr.strip()
body=json.loads(p.stdout)
assert body.get('status')=='ok'
print(json.dumps({'control_api_status':'ok','snapshot_timestamp':body.get('timestamp'),'client_command':command}))
PY
)"

TMP="$(mktemp "$STATE_DIR/.hermes.XXXXXX")"
python3 - "$TMP" "$OBSERVED_JSON" <<'PY'
import datetime,json,os,sys
path=sys.argv[1]
proof=json.loads(sys.argv[2])
record={
  'agent_id':'hermes',
  'observed_at':datetime.datetime.now(datetime.timezone.utc).isoformat(),
  'observation_type':'authenticated_control_api_roundtrip',
  'source_component':'hermes-runtime',
  'control_api_status':proof.get('control_api_status'),
  'snapshot_timestamp':proof.get('snapshot_timestamp'),
  'client_command':proof.get('client_command'),
  'authority_effect':'none',
}
with open(path,'w',encoding='utf-8') as f:
    json.dump(record,f,sort_keys=True)
    f.write('\n')
os.chmod(path,0o644)
PY
mv -f "$TMP" "$STATE_FILE"
echo PHIL_AI_OS_AGENT_HEARTBEAT_OK
