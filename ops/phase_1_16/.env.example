# Control API
PHIL_AI_OS_CONTROL_API_BASE_URL=http://127.0.0.1:4870
PHIL_AI_OS_HEALTH_PATH=/healthz
PHIL_AI_OS_READY_PATH=/readyz

# Optional authenticated JSON endpoint exposing the safety fields documented below.
# Leave unset until the deployed Control API endpoint is confirmed.
# PHIL_AI_OS_SAFETY_SNAPSHOT_URL=http://127.0.0.1:4870/v1/<confirmed-safety-endpoint>
# PHIL_AI_OS_CONTROL_API_TOKEN=

# Monitor behavior
PHIL_AI_OS_MONITOR_INTERVAL_SECONDS=60
PHIL_AI_OS_MONITOR_TIMEOUT_SECONDS=5
PHIL_AI_OS_ALERT_COOLDOWN_SECONDS=1800
PHIL_AI_OS_MONITOR_STATE_PATH=/var/lib/phil-ai-os-monitor/state.json
PHIL_AI_OS_STRICT_SAFETY_SNAPSHOT=false

# Existing Hermes Telegram bot may be reused for outbound-only alerts.
# This monitor does not poll Telegram and does not claim webhook ownership.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
